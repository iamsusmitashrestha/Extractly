# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Extractly?schema=public"

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Security Configuration
CORS_ORIGIN="chrome-extension://*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ACCESS_TOKEN_SECRET="dev_please_change_me"
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
COOKIE_SECURE=false

# Request Configuration
MAX_BODY_SIZE="10mb"
MAX_HTML_SIZE=5242880

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
OAUTH_GOOGLE_REDIRECT_URI="http://localhost:3000/auth/oauth/google/callback"
